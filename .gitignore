# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
wheels/
*.egg-info/

# Unit test / coverage reports
.pytest_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
env/
venv/

# Environment variables & secrets
.env
.env.*
!.env.example

# Local SQLite databases (prevent committing runtime data)
*.db
*.sqlite
*.sqlite3

# Runtime storage & outputs (keep empty directory markers)
uploads/*
!uploads/.keep
outputs/*
!outputs/.keep
runs/

# IDE & OS files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
